{
  "version": 2,
  "builds": [
    { "src": "api/**/*.php", "use": "vercel-php@0.7.1" },
    { "src": "*.php", "use": "vercel-php@0.7.1" },
    { "src": "admin/**/*.php", "use": "vercel-php@0.7.1" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_URL": "@app_url",
    "DATABASE_URL": "@database_url",
    "FIREBASE_API_KEY": "@firebase_api_key",
    "FIREBASE_AUTH_DOMAIN": "@firebase_auth_domain",
    "FIREBASE_PROJECT_ID": "@firebase_project_id",
    "FIREBASE_STORAGE_BUCKET": "@firebase_storage_bucket",
    "FIREBASE_MESSAGING_SENDER_ID": "@firebase_messaging_sender_id",
    "FIREBASE_APP_ID": "@firebase_app_id",
    "FIREBASE_FACEBOOK_APP_ID": "@firebase_facebook_app_id",
    "GEMINI_API_KEY": "@gemini_api_key",
    "GEMINI_MODEL": "gemini-2.0-flash",
    "GCASH_ACCOUNT_NAME": "@gcash_account_name",
    "GCASH_MOBILE": "@gcash_mobile",
    "GCASH_PRO_MONTHLY_PHP": "@gcash_pro_monthly_php",
    "GCASH_PRO_YEARLY_PHP": "@gcash_pro_yearly_php",
    "ADMIN_SECRET": "@admin_secret",
    "SESSION_SECRET": "@session_secret"
  }
}
