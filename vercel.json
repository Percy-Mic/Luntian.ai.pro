{
  "version": 2,
  "builds": [
    { "src": "api/**/*.php", "use": "vercel-php@0.7.1" },
    { "src": "*.php", "use": "vercel-php@0.7.1" },
    { "src": "admin/**/*.php", "use": "vercel-php@0.7.1" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" },
    { "src": "/asset/js/(.*)", "dest": "/asset/js/$1" }
  ],
  "env": {
    "APP_ENV": "production"
  }
}
