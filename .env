# Copy to .env and fill in values. Never commit .env to GitHub.

# App
APP_URL=http://localhost/luntianAi
APP_ENV=local

# PostgreSQL (Aiven) — use SSL in production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Gemini (server-side only — free tier: https://ai.google.dev/pricing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Firebase — public config (also exposed to browser via /api/auth/config.php)
FIREBASE_API_KEY=AIzaSyAhUfQJCLTahQgwTqQgnruK2V70HG_Qifc
FIREBASE_AUTH_DOMAIN=luntian-ai-pro.firebaseapp.com
FIREBASE_PROJECT_ID=luntian-ai-pro
FIREBASE_STORAGE_BUCKET=luntian-ai-pro.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=18068810822
FIREBASE_APP_ID=1:18068810822:web:57ce9812468d3d32c5ae47

# Facebook Login (Meta Developer → your app → Settings → Basic)
FIREBASE_FACEBOOK_APP_ID=

# Manual GCash — upload your QR to public/assets/images/gcash-qr.png
GCASH_ACCOUNT_NAME="Your Name"
GCASH_MOBILE=09XXXXXXXXX
GCASH_PRO_MONTHLY_PHP=1499
GCASH_PRO_YEARLY_PHP=14390

# Admin approves payments manually (choose a long random string)
ADMIN_SECRET=change-this-to-a-long-random-secret

# Session cookie (change in production)
SESSION_SECRET=change-this-session-secret-too
